{
  "name": "healthclaim-pro-root",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Medical Insurance Claim and Intelligent Settlement Platform",
  "scripts": {
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev": "pnpm --filter \"@healthclaim/*\" --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter backend test",
    "test:cov": "pnpm --filter backend test:cov",
    "test:e2e": "playwright test",
    "test:perf": "k6 run perf/k6-load-test.js",
    "lint": "pnpm -r lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "vitest": "^3.2.6",
      "@nestjs/core": "^11.0.0",
      "@nestjs/common": "^11.0.0",
      "@nestjs/platform-express": "^11.0.0",
      "react-router-dom": "^6.30.0",
      "react-router": "^6.30.0",
      "vite": "^6.4.4",
      "lodash": "^4.18.1",
      "picomatch": "^4.0.2",
      "multer": "^2.5.0",
      "glob": "^10.5.0",
      "tmp": "^0.2.3",
      "qs": "^6.17.1",
      "ajv": "^8.17.1",
      "file-type": "^21.3.1",
      "body-parser": "^1.20.9",
      "busboy": "^1.6.0",
      "webpack": "^5.104.1",
      "dompurify": "^3.4.17",
      "fast-uri": "^3.1.9",
      "follow-redirects": "^1.16.2",
      "ip-address": "^10.7.5",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2",
      "undici": "^6.29.1",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=5": "^5.0.12",
      "postcss-selector-parser@<7": "^6.1.5",
      "postcss-selector-parser@>=7": "^7.1.7"
    }
  }
}
