// HealthClaim Pro - Database Schema (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  EMPLOYEE
  CLAIM_OFFICER
  FINANCE_MANAGER
  SYSTEM_ADMIN
  SECURITY_AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            Role              @default(EMPLOYEE)
  status          UserStatus        @default(ACTIVE)
  department      String?
  isEmailVerified Boolean           @default(false)
  
  quotas          UserPolicyQuota[]
  auditLogs       AuditLog[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([email])
  @@index([role])
}

model BenefitTier {
  id                String            @id @default(uuid())
  name              String            @unique
  code              String            @unique
  description       String?
  annualLimit       Decimal           @db.Decimal(12, 2)
  defaultDeductible Decimal           @db.Decimal(12, 2)
  defaultCoPayRate  Decimal           @db.Decimal(5, 4)
  isActive          Boolean           @default(true)
  
  userQuotas        UserPolicyQuota[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model UserPolicyQuota {
  id                       String       @id @default(uuid())
  userId                   String
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  benefitTierId            String
  benefitTier              BenefitTier  @relation(fields: [benefitTierId], references: [id])
  fiscalYear               Int
  annualLimit              Decimal      @db.Decimal(12, 2)
  remainingBalance         Decimal      @db.Decimal(12, 2)
  cumulativeDeductibleSpent Decimal      @default(0) @db.Decimal(12, 2)
  
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([userId, fiscalYear])
  @@index([userId])
  @@index([benefitTierId])
}

model AuditLog {
  id               String   @id @default(uuid())
  actorId          String?
  actor            User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action           String
  targetResource   String
  targetResourceId String?
  details          Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// TODO: Reserved for future Email Verification module
model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}
